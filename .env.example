# Copy to .env.local. Never commit .env.local or use NEXT_PUBLIC_ for secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Use a modern sb_secret_ key here, OR the legacy variable below.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated Supabase Auth user UUIDs. Empty means access is disabled.
FLOAT_ADMIN_USER_IDS=
